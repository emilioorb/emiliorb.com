---
import "../styles/global.css";
import "../components/episodios/episodios.css";
import ScrollSuave from "../components/ScrollSuave.astro";
import Pie from "../components/Pie.astro";
import { CabeceraSerie } from "../components/episodios/CabeceraSerie";
import { TEXTOS, rutaDe, type Idioma } from "../i18n/ui";
import { REDES, TRABAJO, enIdioma } from "../data/contenido";

interface Props {
  idioma: Idioma;
  /** La misma página en cada idioma; por defecto, la portada. */
  rutas?: Record<Idioma, string>;
  meta?: { titulo: string; descripcion: string };
  /**
   * El rótulo de la cabecera de la serie en una página de lectura. `false`
   * cuando la página es la serie misma: ahí la isla dibuja su propia cabecera.
   */
  cabecera: string | false;
  /** Una escena que ocupa la pantalla justa (la librería) no lleva pie: abriría scroll. */
  pie?: boolean;
  /** La escena de la serie a la que vuelve la cabecera de una página de lectura. */
  volver?: string;
}

const { idioma, cabecera, pie = true, volver } = Astro.props;
const t = TEXTOS[idioma];
const rutas = Astro.props.rutas ?? { es: rutaDe("es"), en: rutaDe("en") };
const meta = Astro.props.meta ?? t.meta;
const otro: Idioma = idioma === "es" ? "en" : "es";
const absoluta = (ruta: string) => new URL(ruta, Astro.site).href;
const canonica = absoluta(rutas[idioma]);

const imagenSocial = new URL("/og.png", Astro.site).href;

const LOCALES = { es: "es_CR", en: "en_US" } as const;

const puestosVigentes = TRABAJO.filter((puesto) => puesto.hasta === null);

/** `sameAs` sale de REDES para no duplicar las URLs de los perfiles. */
const personaJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Emilio Rodríguez",
  url: new URL(rutaDe(idioma), Astro.site).href,
  // Cargos y empresas salen de los puestos vigentes, no del antetítulo: ese
  // incluye la empresa, que ya va aparte en `worksFor`.
  // La disciplina va antes que el cargo: es por lo que se busca a una persona.
  jobTitle: [
    "Software Engineer",
    "AI Engineer",
    ...puestosVigentes.map((puesto) => enIdioma(puesto.cargo, idioma)),
  ],
  knowsAbout: ["Software Engineering", "AI Engineering", "Engineering standards"],
  worksFor: puestosVigentes.map((puesto) => ({
    "@type": "Organization",
    name: puesto.empresa,
    ...(puesto.href && { url: puesto.href }),
  })),
  address: {
    "@type": "PostalAddress",
    addressLocality: "San José",
    addressCountry: "CR",
  },
  sameAs: REDES.map((red) => red.href),
};
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{meta.titulo}</title>
    <meta name="description" content={meta.descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="alternate" hreflang="es" href={absoluta(rutas.es)} />
    <link rel="alternate" hreflang="en" href={absoluta(rutas.en)} />
    <link rel="alternate" hreflang="x-default" href={absoluta(rutas.es)} />
    <meta property="og:title" content={meta.titulo} />
    <meta property="og:description" content={meta.descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonica} />
    <meta property="og:site_name" content="Emilio Rodríguez" />
    <meta property="og:locale" content={LOCALES[idioma]} />
    <meta property="og:locale:alternate" content={LOCALES[otro]} />
    <meta property="og:image" content={imagenSocial} />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1080" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@_emiliojrb" />
    <meta name="twitter:creator" content="@_emiliojrb" />
    <meta name="twitter:image" content={imagenSocial} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(personaJsonLd)}
    />
    <meta name="theme-color" content="#ffffff" />

    {/* Sin diferir: el atributo tiene que existir ANTES del primer pintado o
        la página parpadea en claro antes de pasar a oscuro. El tema sigue al
        sistema: la serie no tiene botón de tema, y una elección guardada
        antes no tendría cómo deshacerse. */}
    <script is:inline>
      (() => {
        const raiz = document.documentElement;
        const consulta = window.matchMedia("(prefers-color-scheme: dark)");
        const aplicar = () => {
          const oscuro = consulta.matches;
          raiz.dataset.tema = oscuro ? "oscuro" : "claro";
          const barra = document.querySelector('meta[name="theme-color"]');
          if (barra) barra.content = oscuro ? "#0b0b0c" : "#ffffff";
        };
        aplicar();
        consulta.addEventListener("change", aplicar);
      })();
    </script>
  </head>

  {/* Columna a todo el alto: en páginas cortas el pie quedaba a media pantalla. */}
  <body class="flex min-h-dvh flex-col font-sans antialiased" data-lectura={cabecera ? "" : undefined}>
    <ScrollSuave />
    {
      cabecera && (
        <CabeceraSerie
          rotulo={cabecera}
          tono="claro"
          conFondo
          rutas={{ inicio: rutaDe(idioma), contacto: rutaDe(idioma, "#proximo"), otroIdioma: rutas[otro], volver }}
          textos={t.serie}
        />
      )
    }
    <main class="flex-1">
      <slot />
    </main>
    {pie && <Pie idioma={idioma} />}
  </body>
</html>
