---
import "../styles/global.css";
import ScrollSuave from "../components/ScrollSuave.astro";
import FondoEstrellas from "../components/islas/FondoEstrellas";
import Encabezado from "../components/Encabezado.astro";
import CambioTema from "../components/CambioTema.astro";
import Pie from "../components/Pie.astro";
import { TEXTOS, rutaDe, type Idioma } from "../i18n/ui";
import { REDES, TRABAJO, enIdioma } from "../data/contenido";

interface Props {
  idioma: Idioma;
  /** La misma página en cada idioma; por defecto, la portada. */
  rutas?: Record<Idioma, string>;
  meta?: { titulo: string; descripcion: string };
}

const { idioma } = Astro.props;
const t = TEXTOS[idioma];
const rutas = Astro.props.rutas ?? { es: rutaDe("es"), en: rutaDe("en") };
const meta = Astro.props.meta ?? t.meta;
const otro: Idioma = idioma === "es" ? "en" : "es";
const absoluta = (ruta: string) => new URL(ruta, Astro.site).href;
const canonica = absoluta(rutas[idioma]);

const imagenSocial = new URL("/og.png", Astro.site).href;

const LOCALES = { es: "es_CR", en: "en_US" } as const;

const puestosVigentes = TRABAJO.filter((puesto) => puesto.hasta === null);

/** `sameAs` sale de REDES para no duplicar las URLs de los perfiles. */
const personaJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Emilio Rodríguez",
  url: new URL(rutaDe(idioma), Astro.site).href,
  // Cargos y empresas salen de los puestos vigentes, no del antetítulo: ese
  // incluye la empresa, que ya va aparte en `worksFor`.
  jobTitle: puestosVigentes.map((puesto) => enIdioma(puesto.cargo, idioma)),
  worksFor: puestosVigentes.map((puesto) => ({
    "@type": "Organization",
    name: puesto.empresa,
    ...(puesto.href && { url: puesto.href }),
  })),
  address: {
    "@type": "PostalAddress",
    addressLocality: "San José",
    addressCountry: "CR",
  },
  sameAs: REDES.map((red) => red.href),
};
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{meta.titulo}</title>
    <meta name="description" content={meta.descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="alternate" hreflang="es" href={absoluta(rutas.es)} />
    <link rel="alternate" hreflang="en" href={absoluta(rutas.en)} />
    <link rel="alternate" hreflang="x-default" href={absoluta(rutas.es)} />
    <meta property="og:title" content={meta.titulo} />
    <meta property="og:description" content={meta.descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonica} />
    <meta property="og:site_name" content="Emilio Rodríguez" />
    <meta property="og:locale" content={LOCALES[idioma]} />
    <meta property="og:locale:alternate" content={LOCALES[otro]} />
    <meta property="og:image" content={imagenSocial} />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1080" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@_emiliojrb" />
    <meta name="twitter:creator" content="@_emiliojrb" />
    <meta name="twitter:image" content={imagenSocial} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(personaJsonLd)}
    />
    <meta name="theme-color" content="#ffffff" />

    {/* Sin diferir: el atributo tiene que existir ANTES del primer pintado o
        la página parpadea en claro antes de pasar a oscuro. */}
    <script is:inline>
      (() => {
        const raiz = document.documentElement;
        let elegido = null;
        try {
          elegido = localStorage.getItem("tema");
        } catch {}
        const oscuro =
          elegido === "oscuro" ||
          (elegido !== "claro" &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);
        raiz.dataset.tema = oscuro ? "oscuro" : "claro";
        const barra = document.querySelector('meta[name="theme-color"]');
        if (barra) barra.content = oscuro ? "#0b0b0c" : "#ffffff";
      })();
    </script>
  </head>

  {/* Columna a todo el alto: en páginas cortas el pie quedaba a media pantalla. */}
  <body class="flex min-h-dvh flex-col font-sans antialiased">
    <ScrollSuave />
    {/* `client:idle`: es decoración, puede esperar a que el hilo se libere. */}
    <FondoEstrellas client:idle />
    <Encabezado idioma={idioma} rutaOtro={rutas[otro]} />
    <main class="flex-1">
      <slot />
    </main>
    <Pie idioma={idioma} />
    <CambioTema idioma={idioma} />
  </body>
</html>
