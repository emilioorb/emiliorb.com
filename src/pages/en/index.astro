---
import PaginaSerie from "../../components/PaginaSerie.astro";
import { TEXTOS, rutaDe } from "../../i18n/ui";
import { cargarGuion } from "../../lib/episodios/cargar";

const escenas = await cargarGuion("en");
---

<PaginaSerie
  idioma="en"
  escenas={escenas}
  rutas={{ es: rutaDe("es"), en: rutaDe("en") }}
  meta={TEXTOS.en.meta}
  inicio="#apertura"
  contacto="#proximo"
/>
