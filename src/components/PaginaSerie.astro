---
// Una página contada como la serie: la portada (Episodios) y cada ficha de
// proyecto. La isla dibuja su propia cabecera, que sigue el tono de cada escena.
import Base from "../layouts/Base.astro";
import Episodios from "./islas/Episodios";
import { TEXTOS, type Idioma } from "../i18n/ui";
import type { Escena } from "../lib/episodios/tipos";
import type { RutasSerie } from "./episodios/CabeceraSerie";

interface Props {
  idioma: Idioma;
  escenas: readonly Escena[];
  /** Esta página en cada idioma: alimenta el hreflang y el enlace al otro idioma. */
  rutas: Record<Idioma, string>;
  meta: { titulo: string; descripcion: string };
  /** A dónde llevan el nombre y el contacto de la cabecera. */
  inicio: string;
  contacto: string;
  /** En una página suelta contada como serie (la librería), la escena a la que vuelve. */
  volver?: string;
}

const { idioma, escenas, rutas, meta, inicio, contacto, volver } = Astro.props;
const otro: Idioma = idioma === "es" ? "en" : "es";
const rutasSerie: RutasSerie = { inicio, contacto, otroIdioma: rutas[otro], volver };
const tonoInicial = escenas[0]?.tono ?? "claro";
---

<Base idioma={idioma} rutas={rutas} meta={meta} cabecera={false}>
  {/* Antes de pintar las escenas: con movimiento, el escenario las apila y
      esconde las que todavía no tocan. Si se decidiera al hidratar, la
      segunda escena se vería un instante debajo de la primera. */}
  <script is:inline>
    // Sin barra de desplazamiento, como en una sala de cine: se marca antes
    // del primer pintado para que el ancho no cambie después.
    document.documentElement.dataset.sinBarra = "";
    if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
      document.documentElement.dataset.episodios = "escenario";
    }
  </script>
  {/* El theme-color (Chrome en Android) toma el color de la primera escena desde
      el primer pintado; después la isla lo sigue escena por escena. */}
  <script is:inline define:vars={{ tonoInicial }}>
    const raizHtml = document.documentElement;
    const barra = document.querySelector('meta[name="theme-color"]');
    if (barra && tonoInicial === "invertido") {
      barra.content = getComputedStyle(raizHtml).getPropertyValue("--tinta").trim();
    }
  </script>
  <Episodios client:load escenas={escenas} rutas={rutasSerie} textos={TEXTOS[idioma].serie} />
</Base>
