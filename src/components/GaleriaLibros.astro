---
import { getImage } from "astro:assets";
import GaleriaLibrosIsla, { type LibroGaleria } from "./islas/GaleriaLibros";
import { TEXTOS, type Idioma } from "../i18n/ui";
import { LIBROS, enIdioma } from "../data/contenido";

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const tl = TEXTOS[idioma].libros;

/**
 * "Gene Kim, Kevin Behr" → "Kim · Behr": en un lomo no cabe el nombre entero.
 * Con tres autores o más, el primero y «et al.», como en una cita.
 */
const AUTORES_EN_LOMO = 2;
const apellidos = (autor: string) => {
  const todos = autor.split(",").map((nombre) => nombre.trim().split(" ").at(-1) ?? nombre);
  return todos.length > AUTORES_EN_LOMO ? `${todos[0] ?? ""} et al.` : todos.join(" · ");
};

/**
 * La línea del narrador repite el año de contenido.ts: si el dato cambia y la
 * línea no, el build se corta aquí en vez de narrar algo falso.
 */
function narracionDe(slug: string, anio: string): string {
  const linea = tl.galeria.narrador[slug];
  if (!linea) throw new Error(`Falta la línea del narrador para «${slug}» en ui.ts.`);
  if (!linea.includes(anio)) throw new Error(`La línea del narrador de «${slug}» ya no dice ${anio}; revise ui.ts.`);
  return linea;
}

// Las portadas originales miden ~330 px de ancho: más no existe, así que el
// tamaño grande es el original y el chico sirve a las pantallas de 1x.
const ANCHO_CHICO = 220;

const libros: LibroGaleria[] = await Promise.all(
  LIBROS.map(async (libro) => {
    const portada = await getImage({
      src: libro.portada,
      widths: [ANCHO_CHICO, libro.portada.width],
      format: "webp",
    });
    return {
      slug: libro.slug,
      titulo: libro.titulo,
      autor: libro.autor,
      autorLomo: apellidos(libro.autor),
      anio: libro.anio,
      porQue: enIdioma(libro.porQue, idioma),
      narracion: narracionDe(libro.slug, libro.anio),
      portada: {
        src: portada.src,
        srcset: portada.srcSet.attribute,
        ancho: libro.portada.width,
        alto: libro.portada.height,
      },
      lomo: libro.lomo,
    };
  }),
);
---

<section class="libreria">
  <GaleriaLibrosIsla client:load libros={libros} titulo={tl.titulo} textoElegir={tl.elegir} textos={tl.galeria} />
</section>

<style is:global>
  /* La librería es una escena de la serie: el mismo lienzo, el mismo grano,
     la misma cabecera y el mismo subtítulo.
     Excepción deliberada a DESIGN.md, como el estante del episodio 6: lomos y
     portadas llevan su color, porque un estante monocromo no se lee como
     estante. La repisa y la interfaz siguen en tinta y fondo. */

  /* Registrada para que `getComputedStyle` la devuelva en px: la isla la usa
     para medir cuántas unidades caben en la escena. */
  @property --u {
    syntax: "<length>";
    inherits: true;
    initial-value: 1px;
  }

  .libreria {
    /* El alto del libro elegido: unos dos tercios de la pantalla, sin pasar
       de lo que queda entre la cabecera y el subtítulo. */
    --zona-subtitulos: clamp(5.5rem, 12svh, 7rem);
    /* A lo sumo ~48svh, y nunca más de lo que deja la pantalla entre la
       cabecera y el subtítulo: la escena entera cabe sin scroll. */
    --alto-libro: min(48svh, 27vw, calc(100svh - var(--alto-cabecera) - var(--zona-subtitulos) - 7rem));
    --u: calc(var(--alto-libro) / 300);
    /* La repisa: la tabla de arriba y el canto de frente. La luz viene de
       arriba a la izquierda, así que la tabla es más clara que el canto. */
    --repisa-tabla: color-mix(in srgb, var(--tinta) 4%, var(--fondo));
    --repisa-canto: color-mix(in srgb, var(--tinta) 12%, var(--fondo));
    --repisa-filo: color-mix(in srgb, var(--tinta) 20%, var(--fondo));
    --sombra: rgb(0 0 0 / 0.22);
    --sombra-contacto: rgb(0 0 0 / 0.55);
    --atenuado: brightness(0.93) saturate(0.88);
    position: relative;
    display: flex;
    height: 100svh;
    flex-direction: column;
    justify-content: center;
    padding: calc(var(--alto-cabecera) + 0.5rem) var(--pad-seccion) var(--zona-subtitulos);
    overflow: clip;
    background: var(--fondo);
    color: var(--tinta);
  }

  /* El grano de película de las escenas, quieto, por encima de todo. */
  .libreria::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    opacity: 0.09;
    background-image: var(--grano);
    background-size: 180px;
  }

  :root[data-tema="oscuro"] .libreria {
    --repisa-tabla: color-mix(in srgb, var(--tinta) 7%, var(--fondo));
    --repisa-canto: color-mix(in srgb, var(--tinta) 4%, var(--fondo));
    --repisa-filo: color-mix(in srgb, var(--tinta) 22%, var(--fondo));
    --sombra: rgb(0 0 0 / 0.6);
    --sombra-contacto: rgb(0 0 0 / 0.85);
    --atenuado: brightness(0.74) saturate(0.85);
  }

  /* La columna de las escenas: 64rem centrada, como el resto de la serie. */
  .libreria__marco {
    display: grid;
    width: 100%;
    max-width: 64rem;
    margin-inline: auto;
    gap: clamp(1rem, 2.5svh, 1.75rem);
  }

  /* Escritorio: la ficha a la izquierda de la columna, la repisa a su lado. */
  @media (min-width: 1100px) {
    .libreria__marco {
      grid-template-columns: minmax(14rem, 19rem) minmax(0, 1fr);
      align-items: end;
      column-gap: clamp(1.5rem, 3vw, 3.5rem);
    }

    .libreria__ficha {
      grid-row: 1;
      grid-column: 1;
      /* La última línea de la ficha se apoya a la altura de la tabla. */
      padding-bottom: calc(var(--piso) * var(--u));
    }

    .libreria__escena {
      grid-row: 1;
      grid-column: 2;
    }
  }

  @media (max-width: 1099px) {
    .libreria {
      /* En el teléfono el libro aprovecha el alto: lo que queda después de
         la cabecera, la ficha y el subtítulo. */
      --zona-subtitulos: 7rem;
      --alto-libro: min(44svh, 100vw, calc((100svh - var(--alto-cabecera) - var(--zona-subtitulos) - 16rem) * 0.8));
      height: auto;
      min-height: 100svh;
    }

    /* En el teléfono, un solo eje centrado: el libro, la ficha y las
       flechas debajo, igual que el subtítulo. */
    .libreria__ficha {
      text-align: center;
    }

    .libreria__texto {
      justify-items: center;
    }

    .libreria__flechas {
      justify-content: center;
    }

    .libreria__escena {
      margin-inline: calc(-1 * var(--pad-seccion));
    }
  }

  /* —— Escena 3D —— */
  .libreria__escena {
    /* Distancia de la base al borde de abajo, en unidades: cabe el canto de
       la repisa y la sombra del elegido. */
    --piso: 34;
    position: relative;
    height: calc((300 + 30 + var(--piso)) * var(--u));
    overflow: clip;
    perspective: calc(2400 * var(--u));
    /* La cámara apenas por encima de la repisa: la tabla se ve como un filo
       y no como un bloque. */
    perspective-origin: 50% 34%;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    cursor: grab;
  }

  .libreria__escena:active {
    cursor: grabbing;
  }

  .libreria__mundo,
  .libreria__fila,
  .libreria__libros {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }

  .libreria__fila {
    transition: translate 420ms var(--ease-out);
  }

  .libreria__fila[data-arrastrando="true"] {
    transition: none;
  }

  /* Los lomos caen justo en el plano de la fila: sin esto, los contenedores
     ganan el clic a los libros. El arrastre lo escucha la escena, debajo. */
  .libreria__mundo,
  .libreria__fila,
  .libreria__libros,
  .libreria__ranura,
  .repisa {
    pointer-events: none;
  }

  /* La repisa: una tabla con espesor, del fondo de los libros hasta delante
     del elegido, del largo de la escena. Todos apoyan en la misma base. */
  .repisa {
    position: absolute;
    bottom: calc(var(--piso) * var(--u));
    left: 50%;
    width: calc(var(--largo-repisa) * var(--u));
    height: 0;
    margin-left: calc(var(--largo-repisa) * var(--u) / -2);
    transform-style: preserve-3d;
  }

  .repisa__tabla {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: calc(200 * var(--u));
    transform-origin: 50% 100%;
    transform: translateZ(calc(96 * var(--u))) rotateX(90deg);
    background: var(--repisa-tabla);
  }

  .repisa__canto {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: calc(5 * var(--u));
    transform: translateZ(calc(96 * var(--u)));
    border-top: 1px solid var(--repisa-filo);
    background: var(--repisa-canto);
  }

  .libreria__ranura {
    position: absolute;
    bottom: calc(var(--piso) * var(--u));
    left: 50%;
    width: calc(var(--ancho) * var(--u));
    height: calc(var(--alto) * var(--u));
    margin-left: calc(var(--ancho) * var(--u) / -2);
    /* Desde la base: al achicarse en la repisa, el libro no se despega de ella. */
    transform-origin: 50% 100%;
    transform-style: preserve-3d;
  }

  .libreria__escena[data-medida="true"] .libreria__ranura {
    transition:
      transform 620ms var(--ease-out),
      translate 240ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .libreria__ranura[data-elegido="false"]:hover {
      translate: 0 calc(-8 * var(--u));
    }
  }

  .libro3d {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    pointer-events: auto;
    transform-style: preserve-3d;
    -webkit-tap-highlight-color: transparent;
  }

  .libreria__ranura[data-elegido="true"] .libro3d {
    cursor: grab;
  }

  /* La caja del botón queda de canto al girar: el foco se dibuja en la cara
     que se ve. */
  .libro3d:focus-visible {
    outline: none;
  }

  .libro3d:focus-visible .libro3d__cara--lomo,
  .libreria__ranura[data-elegido="true"] .libro3d:focus-visible .libro3d__cara--portada {
    outline: 2px solid var(--tinta);
    outline-offset: 4px;
  }

  .libro3d__cara {
    position: absolute;
    display: block;
    backface-visibility: hidden;
    transition:
      filter 420ms var(--ease-out),
      opacity 320ms var(--ease-out);
  }

  /* Lo que no cabe en la repisa se apaga y deja de recibir el puntero. */
  .libreria__ranura[data-fuera="true"] .libro3d__cara {
    opacity: 0;
  }

  .libreria__ranura[data-fuera="true"] .libro3d {
    pointer-events: none;
  }

  /* Los de la repisa quedan en penumbra: el elegido es el que tiene la luz. */
  .libreria__ranura[data-elegido="false"] .libro3d__cara {
    filter: var(--atenuado);
  }

  @media (hover: hover) and (pointer: fine) {
    .libreria__ranura[data-elegido="false"]:hover .libro3d__cara {
      filter: none;
    }
  }

  /* Tela del lomo y contratapa: el color del libro con un grano muy fino. */
  .libro3d__cara--lomo,
  .libro3d__cara--contra {
    background-color: var(--fondo-lomo);
    background-image: var(--grano);
    background-size: 120px;
    background-blend-mode: soft-light;
  }

  .libro3d__cara--portada {
    inset: 0;
    transform: translateZ(calc(var(--grosor) * var(--u) / 2));
    border-radius: 1px 3px 3px 1px;
    background: var(--fondo-lomo);
  }

  .libro3d__cara--portada img {
    width: 100%;
    height: 100%;
    border-radius: inherit;
    object-fit: cover;
    pointer-events: none;
  }

  /* La misma luz que los lomos: entra por la izquierda y cae hacia la derecha.
     Sobre la tapa, más el pliegue de la bisagra cerca del lomo. */
  .libro3d__luz {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background:
      linear-gradient(to right, rgb(0 0 0 / 0.16) 0 1.2%, rgb(255 255 255 / 0.22) 1.2% 1.8%, transparent 1.8% 4.5%, rgb(0 0 0 / 0.12) 4.5% 5%, transparent 5%),
      linear-gradient(105deg, rgb(255 255 255 / 0.14), transparent 38%, transparent 70%, rgb(0 0 0 / 0.14));
  }

  /* La sombra que la tapa proyecta hacia atrás y a la derecha. */
  .libro3d__cara--portada::after {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    box-shadow:
      calc(14 * var(--u)) calc(26 * var(--u)) calc(44 * var(--u)) calc(-10 * var(--u)) var(--sombra),
      calc(3 * var(--u)) calc(6 * var(--u)) calc(10 * var(--u)) calc(-4 * var(--u)) var(--sombra);
    opacity: 0;
    transition: opacity 420ms var(--ease-out);
  }

  .libreria__ranura[data-elegido="true"] .libro3d__cara--portada::after {
    opacity: 1;
  }

  .libro3d__cara--contra {
    inset: 0;
    transform: rotateY(180deg) translateZ(calc(var(--grosor) * var(--u) / 2));
    filter: brightness(0.8);
  }

  .libro3d__cara--lomo,
  .libro3d__cara--cantos {
    top: 0;
    left: calc((var(--ancho) - var(--grosor)) * var(--u) / 2);
    width: calc(var(--grosor) * var(--u));
    height: 100%;
  }

  .libro3d__cara--lomo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(10 * var(--u));
    padding-block: calc(26 * var(--u)) calc(18 * var(--u));
    overflow: hidden;
    border-radius: calc(3 * var(--u));
    color: var(--tinta-lomo);
    transform: rotateY(-90deg) translateZ(calc(var(--ancho) * var(--u) / 2));
  }

  /* Volumen y bisagras: la luz entra por la izquierda, como en toda la escena.
     El lomo se curva (claro a la izquierda, oscuro a la derecha) y cerca de
     cada canto corre la bisagra de la tapa, una sombra fina con su brillo. */
  .libro3d__volumen {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(
      to right,
      rgb(0 0 0 / 0.3) 0,
      rgb(0 0 0 / 0.08) 5%,
      rgb(0 0 0 / 0.2) 8%,
      rgb(255 255 255 / 0.2) 10%,
      rgb(255 255 255 / 0.1) 22%,
      rgb(255 255 255 / 0) 45%,
      rgb(0 0 0 / 0.06) 75%,
      rgb(0 0 0 / 0.22) 89%,
      rgb(255 255 255 / 0.1) 91%,
      rgb(0 0 0 / 0.16) 95%,
      rgb(0 0 0 / 0.36) 100%
    );
  }

  /* Cabezada arriba y abajo: dos filetes finos en el color de la letra. */
  .libro3d__cara--lomo::before,
  .libro3d__cara--lomo::after {
    content: "";
    position: absolute;
    right: 12%;
    left: 12%;
    height: calc(3 * var(--u));
    border-block: 1px solid currentColor;
    opacity: 0.3;
  }

  .libro3d__cara--lomo::before {
    top: calc(10 * var(--u));
  }

  .libro3d__cara--lomo::after {
    bottom: calc(8 * var(--u));
  }

  .libro3d__titulo,
  .libro3d__autor {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    writing-mode: vertical-rl;
  }

  .libro3d__titulo {
    position: relative;
    flex: none;
    max-height: 100%;
    font-size: calc(15 * var(--u));
    font-weight: 650;
    letter-spacing: 0.005em;
  }

  .libro3d__autor {
    position: relative;
    flex: 0 1 auto;
    min-height: 0;
    margin-top: auto;
    font-size: calc(8.5 * var(--u));
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    opacity: 0.72;
  }

  /* La marca de abajo: el año, horizontal, como el sello de una editorial. */
  .libro3d__marca {
    position: relative;
    flex: none;
    font-size: calc(8 * var(--u));
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    opacity: 0.6;
  }

  /* El canto de las hojas y la cabeza: papel, del mismo tono en los dos temas. */
  .libro3d__cara--cantos {
    transform: rotateY(90deg) translateZ(calc(var(--ancho) * var(--u) / 2));
    /* Del lado opuesto a la luz: hojas finas en penumbra. */
    background:
      linear-gradient(to right, rgb(0 0 0 / 0.18), rgb(0 0 0 / 0.04) 30%, rgb(0 0 0 / 0.12)),
      repeating-linear-gradient(to right, #ece7dd 0 1px, #ddd6c9 1px 2px);
  }

  .libro3d__cara--cabeza {
    top: calc((var(--alto) - var(--grosor)) * var(--u) / 2);
    left: 0;
    width: 100%;
    height: calc(var(--grosor) * var(--u));
    transform: rotateX(90deg) translateZ(calc(var(--alto) * var(--u) / 2));
    background: repeating-linear-gradient(to bottom, #e9e4da 0 2px, #d9d3c7 2px 3px);
  }

  /* Sombra de contacto del elegido sobre la tabla, corrida hacia la derecha
     como la de la tapa. Cada libro tiene la suya; solo se enciende la del
     elegido, así lo acompaña al moverse. */
  .libro3d__sombra {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: calc(var(--ancho) * 1.35 * var(--u));
    height: calc(120 * var(--u));
    margin-left: calc(var(--ancho) * -0.6 * var(--u));
    transform-origin: 50% 100%;
    transform: translateZ(calc(40 * var(--u))) rotateX(90deg);
    /* La de contacto, corta y nítida, pegada a la base; la amplia y difusa,
       corrida hacia la derecha y hacia atrás, lejos de la luz. */
    background:
      radial-gradient(ellipse 38% 9% at 50% 66%, var(--sombra-contacto), transparent),
      radial-gradient(ellipse 50% 42% at 58% 48%, var(--sombra), transparent);
    opacity: 0.45;
    pointer-events: none;
    transition: opacity 420ms var(--ease-out);
  }

  .libreria__ranura[data-elegido="true"] .libro3d__sombra {
    opacity: 1;
  }

  .libreria__ranura[data-fuera="true"] .libro3d__sombra {
    opacity: 0;
  }

  /* —— Ficha del elegido, con la letra de las escenas —— */
  .libreria__ficha {
    container-type: inline-size;
    min-width: 0;
  }

  .libreria__texto {
    display: grid;
    gap: 0.75rem;
    animation: ficha-entra 320ms var(--ease-out);
  }

  .libreria__titulo {
    margin: 0;
    /* Se mide contra su columna: «Engineering», la palabra más larga, entra
       entera sin cortarse y sin llegar a la repisa. */
    font-size: clamp(1.75rem, min(14.5cqi, 9svh), 4.75rem);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .libreria__titulo cite {
    font-style: normal;
  }

  .libreria__autor {
    margin: 0;
    text-wrap: balance;
    font-size: clamp(0.875rem, 0.8rem + 0.3vw, 1rem);
    color: var(--tinta-suave);
  }

  .libreria__porque {
    margin: 0.5rem 0 0;
    max-width: 30ch;
    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.4rem);
    font-weight: 500;
    line-height: 1.35;
    text-wrap: pretty;
  }

  @keyframes ficha-entra {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .libreria__flechas {
    display: flex;
    gap: 0.5rem;
    margin-top: clamp(1rem, 3svh, 1.75rem);
  }

  .libreria__flecha {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 1px solid var(--borde);
    border-radius: 9999px;
    background: none;
    color: var(--tinta);
    cursor: pointer;
    transition:
      border-color 200ms var(--ease-out),
      opacity 200ms var(--ease-out),
      transform 140ms var(--ease-out);
  }

  .libreria__flecha svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (hover: hover) and (pointer: fine) {
    .libreria__flecha:hover:not([aria-disabled="true"]) {
      border-color: var(--tinta);
    }
  }

  .libreria__flecha[aria-disabled="true"] {
    opacity: 0.3;
    cursor: default;
  }

  @media (max-width: 1099px) {
    .libreria__titulo {
      font-size: clamp(1.75rem, min(9cqi, 6svh), 3rem);
    }
    .libreria__porque {
      max-width: 36ch;
      font-size: 1.05rem;
    }
    .libreria__flechas {
      margin-top: 1rem;
    }
  }

  /* El subtítulo del narrador vive dentro de la escena, al pie, y no flota
     sobre el pie de página. Sin las tarjetas de la serie debajo, no lleva
     placa. */
  .libreria .subtitulos {
    position: absolute;
    bottom: calc(1.5rem + env(safe-area-inset-bottom));
  }

  .libreria .subtitulos[data-tono] .subtitulos__linea {
    padding: 0;
    border: 0;
