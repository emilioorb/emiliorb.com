---
import { enIdioma, type Proyecto } from "../data/contenido";
import type { Idioma } from "../i18n/ui";

interface Props {
  proyectos: readonly Proyecto[];
  idioma: Idioma;
  visitar: string;
}

const { proyectos, idioma, visitar } = Astro.props;
---

<ol class="mt-12 divide-y divide-borde border-y border-borde">
  {
    proyectos.map((proyecto) => {
      const Fila = proyecto.href ? "a" : "div";
      return (
        <li>
          <Fila
            {...(proyecto.href
              ? {
                  href: proyecto.href,
                  target: "_blank",
                  rel: "noopener noreferrer",
                  "aria-label": `${proyecto.nombre} — ${visitar}`,
                }
              : {})}
            class="group flex flex-col gap-1 py-5 no-underline sm:flex-row sm:gap-8"
          >
            <p class="shrink-0 text-sm text-tinta-suave tabular-nums sm:w-28">
              {proyecto.anio}
            </p>
            <div>
              <p class="flex items-center gap-1.5 font-medium transition-colors duration-200 group-hover:text-tinta-suave">
                {proyecto.nombre}
                {proyecto.href && (
                  <svg
                    class="h-3.5 w-3.5 shrink-0 text-tinta-suave"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M7 17 17 7M7 7h10v10" />
                  </svg>
                )}
              </p>
              <p class="mt-2 max-w-xl text-sm leading-relaxed text-tinta-suave">
                {enIdioma(proyecto.detalle, idioma)}
              </p>
              {proyecto.stack.length > 0 && (
                <p class="mt-3 text-xs text-tinta-suave">
                  {proyecto.stack.join(" · ")}
                </p>
              )}
            </div>
          </Fila>
        </li>
      );
    })
  }
</ol>
