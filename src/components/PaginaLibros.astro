---
import PaginaSerie from "./PaginaSerie.astro";
import { TEXTOS, RUTAS_LIBROS, type Idioma } from "../i18n/ui";
import { cargarLibros } from "../lib/episodios/cargar";
import { rutasSerie } from "../lib/episodios/rutas";

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const serie = rutasSerie(idioma);
const escenas = await cargarLibros(idioma);
---

{/* La librería se cuenta como la serie: un libro por escena, con el narrador. */}
<PaginaSerie
  idioma={idioma}
  escenas={escenas}
  rutas={RUTAS_LIBROS}
  meta={TEXTOS[idioma].libros.meta}
  inicio={serie.inicio}
  contacto={serie.contacto}
  volver={serie.libros}
/>
