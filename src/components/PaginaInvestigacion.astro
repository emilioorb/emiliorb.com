---
import Base from "../layouts/Base.astro";
import ListaPapers from "./ListaPapers.astro";
import { TEXTOS, RUTAS_INVESTIGACION, type Idioma } from "../i18n/ui";
import { INVESTIGACION } from "../data/contenido";

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const ti = TEXTOS[idioma].investigacion;
---

<Base idioma={idioma} rutas={RUTAS_INVESTIGACION} meta={ti.meta}>
  <section class="mx-auto max-w-4xl px-6 pt-32 pb-[var(--aire-seccion-bottom)] sm:pt-40">
    <h1 class="text-[clamp(2rem,6vw,4rem)] leading-[1.1] font-medium tracking-[-0.03em]">
      {ti.titulo}
    </h1>
    <p class="mt-6 max-w-xl leading-relaxed text-tinta-suave">{ti.bajada}</p>
    <ListaPapers papers={INVESTIGACION} idioma={idioma} />
  </section>
</Base>
