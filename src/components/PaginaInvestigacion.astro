---
import Base from "../layouts/Base.astro";
import { TEXTOS, RUTAS_INVESTIGACION, rutasPaper, type Idioma } from "../i18n/ui";
import { INVESTIGACION, enIdioma } from "../data/contenido";

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const ti = TEXTOS[idioma].investigacion;
---

<Base idioma={idioma} rutas={RUTAS_INVESTIGACION} meta={ti.meta}>
  <section class="mx-auto max-w-4xl px-6 pt-32 pb-[var(--aire-seccion-bottom)] sm:pt-40">
    <h1 class="text-[clamp(2rem,6vw,4rem)] leading-[1.1] font-medium tracking-[-0.03em]">
      {ti.titulo}
    </h1>
    <p class="mt-6 max-w-xl leading-relaxed text-tinta-suave">{ti.bajada}</p>

    <ol class="mt-12 divide-y divide-borde border-y border-borde">
      {
        INVESTIGACION.map((paper) => (
          <li>
            <a
              href={rutasPaper(paper.slug)[idioma]}
              aria-label={`${paper.titulo} — ${ti.leer}`}
              class="group flex flex-col gap-1 py-5 no-underline sm:flex-row sm:gap-8"
            >
              <p class="shrink-0 text-sm text-tinta-suave sm:w-28">{ti.estados[paper.estado]}</p>
              <div>
                <p
                  lang="en"
                  class="max-w-xl font-medium text-balance transition-colors duration-200 group-hover:text-tinta-suave"
                >
                  {paper.titulo}
                </p>
                <p class="mt-2 max-w-xl text-sm leading-relaxed text-tinta-suave">
                  {enIdioma(paper.resumen, idioma)}
                </p>
                <p class="mt-3 text-xs text-tinta-suave">{paper.proyecto}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Base>
