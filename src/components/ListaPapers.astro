---
import { TEXTOS, rutasPaper, type Idioma } from "../i18n/ui";
import { enIdioma, type Paper } from "../data/contenido";

interface Props {
  papers: readonly Paper[];
  idioma: Idioma;
}

const { papers, idioma } = Astro.props;
const ti = TEXTOS[idioma].investigacion;
---

<ol class="mt-12 divide-y divide-borde border-y border-borde">
  {
    papers.map((paper) => (
      <li>
        <a
          href={rutasPaper(paper.slug)[idioma]}
          aria-label={`${paper.titulo} — ${ti.leer}`}
          class="group flex flex-col gap-1 py-5 no-underline sm:flex-row sm:gap-8"
        >
          <p class="shrink-0 text-sm text-tinta-suave sm:w-28">{ti.estados[paper.estado]}</p>
          <div>
            <p
              lang="en"
              class="max-w-xl font-medium text-balance transition-colors duration-200 group-hover:text-tinta-suave"
            >
              {paper.titulo}
            </p>
            <p class="mt-2 max-w-xl text-sm leading-relaxed text-tinta-suave">
              {enIdioma(paper.resumen, idioma)}
            </p>
            <p class="mt-3 text-xs text-tinta-suave">{paper.proyecto}</p>
          </div>
        </a>
      </li>
    ))
  }
</ol>
